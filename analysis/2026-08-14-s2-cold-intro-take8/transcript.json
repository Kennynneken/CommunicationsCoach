  "segments": [
    {
      "text": "Damn brother, I",
      "start": 1.74,
      "end": 3.94
    },
    {
      "text": "Imagine you've really seen some shit in your day. I",
      "start": 4.38,
      "end": 8.26
    },
    {
      "text": "Couldn't imagine what it's like to just be around people who are sick all day",
      "start": 8.26,
      "end": 12.18
    },
    {
      "text": "I imagine that you've seen some things that you can never unsee",
      "start": 12.18,
      "end": 16.16
    },
    {
      "text": "How'd you move forward through it?",
      "start": 16.72,
      "end": 18.48
    }
  ]
